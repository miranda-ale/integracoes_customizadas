{
 "actions": [],
 "doctype": "DocType",
 "field_order": [
  "api_key",
  "section_break_status",
  "ultima_sincronizacao_sucesso",
  "falhas_consecutivas",
  "tipo_ultima_falha",
  "column_break_status",
  "ultimo_erro",
  "ultimo_erro_status_http",
  "section_break_circuito",
  "circuito_aberto",
  "circuito_tipo_falha",
  "circuito_motivo",
  "column_break_circuito",
  "circuito_aberto_em",
  "circuito_nivel_backoff",
  "circuito_proxima_tentativa"
 ],
 "fields": [
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "Chave pública da API",
   "reqd": 1
  },
  {
   "fieldname": "section_break_status",
   "fieldtype": "Section Break",
   "label": "Status da sincronização"
  },
  {
   "fieldname": "ultima_sincronizacao_sucesso",
   "fieldtype": "Datetime",
   "label": "Última sincronização bem-sucedida",
   "read_only": 1
  },
  {
   "fieldname": "falhas_consecutivas",
   "fieldtype": "Int",
   "label": "Falhas consecutivas",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "tipo_ultima_falha",
   "fieldtype": "Data",
   "label": "Tipo da última falha",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ultimo_erro",
   "fieldtype": "Small Text",
   "label": "Último erro",
   "read_only": 1
  },
  {
   "fieldname": "ultimo_erro_status_http",
   "fieldtype": "Int",
   "label": "Status HTTP do último erro",
   "read_only": 1
  },
  {
   "fieldname": "section_break_circuito",
   "fieldtype": "Section Break",
   "label": "Circuit breaker"
  },
  {
   "fieldname": "circuito_aberto",
   "fieldtype": "Check",
   "label": "DataJud pausado (circuito aberto)",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "circuito_tipo_falha",
   "fieldtype": "Select",
   "label": "Tipo de falha que abriu o circuito",
   "options": "\nAutenticação\nLimite de Requisições\nNão Encontrado\nIndisponível\nDados Inválidos",
   "read_only": 1,
   "depends_on": "eval:doc.circuito_aberto"
  },
  {
   "fieldname": "circuito_motivo",
   "fieldtype": "Small Text",
   "label": "Motivo da pausa",
   "read_only": 1,
   "depends_on": "eval:doc.circuito_aberto"
  },
  {
   "fieldname": "column_break_circuito",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "circuito_aberto_em",
   "fieldtype": "Datetime",
   "label": "Circuito aberto em",
   "read_only": 1,
   "depends_on": "eval:doc.circuito_aberto"
  },
  {
   "fieldname": "circuito_nivel_backoff",
   "fieldtype": "Int",
   "label": "Nível de backoff",
   "read_only": 1,
   "default": "0",
   "depends_on": "eval:doc.circuito_aberto"
  },
  {
   "fieldname": "circuito_proxima_tentativa",
   "fieldtype": "Datetime",
   "label": "Próxima tentativa automática",
   "read_only": 1,
   "depends_on": "eval:doc.circuito_aberto && doc.circuito_tipo_falha != 'Autenticação'"
  }
 ],
 "issingle": 1,
 "module": "Juridico",
 "name": "DataJud Settings",
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1}
 ]
}
